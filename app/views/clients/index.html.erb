<div class="mx-auto max-w-screen-2xl p-4 md:p-6 2xl:p-10">
  <!-- Header -->
  <div class="mb-6 flex flex-col gap-3 md:flex-row md:items-center md:justify-between">
    <div>
      <h2 class="text-title-md2 font-semibold text-black dark:text-white">
        Meus Pacientes
      </h2>
      <nav>
        <ol class="flex items-center gap-2">
          <span class="text-black dark:text-white">Pacientes</span>
          <span class="text-slate-500 dark:text-slate-400">
            • Total: <%= @clients.total_count || @clients.count %> cliente(s)
            <% if params[:archived] == 'true' %>
              (Arquivados)
            <% else %>
              (Ativos)
            <% end %>
          </span>
        </ol>
      </nav>
    </div>
    <!-- Só mostrar botão "Novo Cliente" se não estiver na aba de arquivados -->
    <% unless params[:archived] == 'true' %>
      <%= link_to new_client_path, 
        class: "w-full md:w-auto inline-flex items-center justify-center gap-2.5 rounded-md bg-green-600 px-6 py-2.5 text-center font-medium text-white transition hover:bg-green-700 hover:shadow-lg" do %>
        <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"/>
        </svg>
        Novo Cliente
      <% end %>
    <% end %>
  </div>
  <!-- ✅ Abas para Ativos/Arquivados -->
  <div class="mb-6">
    <div class="border-b border-stroke dark:border-strokedark">
      <nav class="-mb-px flex space-x-8">
        <%= link_to clients_path, 
            class: "#{params[:archived] != 'true' ? 'border-primary text-primary' : 'border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300'} whitespace-nowrap py-2 px-1 border-b-2 font-medium text-sm transition-colors" do %>
          <div class="flex items-center gap-2">
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197m13.5-9a2.25 2.25 0 11-4.5 0 2.25 2.25 0 014.5 0z"/>
            </svg>
            <span>Pacientes Ativos</span>
            <span class="inline-flex items-center rounded-full bg-blue-100 px-2 py-0.5 text-xs font-medium text-blue-800 dark:bg-blue-900 dark:text-blue-200">
              <%= current_user.clients.where(archived_at: nil).count %>
            </span>
          </div>
        <% end %>
        <%= link_to clients_path(archived: true), 
            class: "#{params[:archived] == 'true' ? 'border-primary text-primary' : 'border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300'} whitespace-nowrap py-2 px-1 border-b-2 font-medium text-sm transition-colors" do %>
          <div class="flex items-center gap-2">
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 8l4 4 4-4m-6 0h12a2 2 0 012 2v8a2 2 0 01-2 2H5a2 2 0 01-2-2v-8a2 2 0 012-2z"/>
            </svg>
            <span>Arquivados</span>
            <span class="inline-flex items-center rounded-full bg-orange-100 px-2 py-0.5 text-xs font-medium text-orange-800 dark:bg-orange-900 dark:text-orange-200">
              <%= current_user.clients.archived.count %>
            </span>
          </div>
        <% end %>
      </nav>
    </div>
  </div>
  <!-- Card de Busca e Filtros -->
  <% unless params[:archived] == 'true' %>
    <div class="mb-6 rounded-sm border border-stroke bg-white shadow-default dark:border-strokedark dark:bg-boxdark">
      <div class="border-b border-stroke px-6.5 py-4 dark:border-strokedark">
        <div class="flex items-center gap-3">
          <svg class="h-5 w-5 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
          </svg>
          <h3 class="font-medium text-black dark:text-white">
            Buscar e Filtrar Pacientes
          </h3>
        </div>
      </div>
      <div class="p-6.5">
        <%= form_with url: clients_path, method: :get, local: true, class: "search-form" do |f| %>
          <div class="grid grid-cols-1 gap-4 md:grid-cols-6">
            <!-- Campo de Busca Principal -->
            <div class="md:col-span-2">
              <label class="mb-2.5 block text-sm font-medium text-black dark:text-white">
                Buscar Cliente
              </label>
              <div class="relative">
                <span class="absolute left-5 top-4 text-slate-400">
                  <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
                  </svg>
                </span>
                <%= text_field_tag :search, 
                                   params[:search], 
                                   placeholder: "Nome, email ou telefone...",
                                   class: "w-full rounded-lg border-[1.5px] border-stroke bg-transparent pl-12 pr-5 py-3 font-medium outline-none transition focus:border-primary active:border-primary dark:border-form-strokedark dark:bg-form-input dark:focus:border-primary",
                                   autocomplete: "off" %>
              </div>
            </div>
            <!-- Filtro por Status -->
            <div>
              <label class="mb-2.5 block text-sm font-medium text-black dark:text-white">
                Status
              </label>
              <!-- Atualizar o select de status -->
              <%= select_tag :status,
                options_for_select([
                  ['Todos os Status', ''],
                  ['Ativo', 'active'],
                  ['Expira em Breve', 'expiring'],
                  ['Período Finalizado', 'expired']
                ], params[:status]),
                class: "w-full rounded-lg border-[1.5px] border-stroke bg-transparent px-5 py-3 font-medium outline-none transition focus:border-primary active:border-primary dark:border-form-strokedark dark:bg-form-input dark:focus:border-primary" %>
            </div>
            <!-- Filtro por Período -->
            <div>
              <label class="mb-2.5 block text-sm font-medium text-black dark:text-white">
                Período
              </label>
              <%= select_tag :period,
                            options_for_select([
                              ['Todos os Períodos', ''],
                              ['Este Mês', 'this_month'],
                              ['Últimos 3 Meses', 'last_3_months'],
                              ['Este Ano', 'this_year']
                            ], params[:period]),
                            class: "w-full rounded-lg border-[1.5px] border-stroke bg-transparent px-5 py-3 font-medium outline-none transition focus:border-primary active:border-primary dark:border-form-strokedark dark:bg-form-input dark:focus:border-primary" %>
            </div>
            <!-- Ordenação -->
            <div>
              <label class="mb-2.5 block text-sm font-medium text-black dark:text-white">
                Ordenar por
              </label>
              <%= select_tag :sort_by,
                            options_for_select([
                              ['Nome', 'name'],
                              ['Mais Recentes', 'created_at_desc'],
                              ['Mais Antigos', 'created_at_asc'],
                            ], params[:sort_by]),
                            class: "w-full rounded-lg border-[1.5px] border-stroke bg-transparent px-5 py-3 font-medium outline-none transition focus:border-primary active:border-primary dark:border-form-strokedark dark:bg-form-input dark:focus:border-primary" %>
            </div>
            <!-- Botões de Ação -->
            <div>
              <label class="mb-2.5 block text-sm font-medium text-black dark:text-white">
                Ações
              </label>
              <div class="flex flex-col gap-2 md:flex-row md:gap-2">
                <%= submit_tag "Buscar", class: "w-full md:w-auto inline-flex items-center justify-center rounded-md bg-slate-600 px-4 py-2.5 text-center font-medium text-white transition hover:bg-slate-700" %>
                <%= link_to "Limpar", clients_path, class: "w-full md:w-auto inline-flex items-center justify-center rounded-md bg-slate-600 px-4 py-2.5 text-center font-medium text-white transition hover:bg-slate-700" %>
              </div>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>
  <!-- Resultados da Busca -->
  <% if params[:search].present? || params.slice(:status, :period).values.any?(&:present?) %>
    <div class="mb-6 rounded-sm border border-meta-9 bg-meta-9/10 p-4 dark:border-meta-9 dark:bg-meta-9/20">
      <div class="flex items-center gap-3">
        <svg class="h-5 w-5 text-meta-9" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
        </svg>
        <div>
          <h4 class="font-medium text-meta-9">Resultados da busca</h4>
          <p class="text-sm text-meta-9/80">
            Encontrados <%= @clients.total_count || @clients.count %> cliente(s)
            <% if params[:search].present? %>
              para "<strong><%= params[:search] %></strong>"
            <% end %>
            <% if params[:archived] == 'true' %>
              <strong>nos arquivos</strong>
            <% end %>
          </p>
        </div>
      </div>
    </div>
  <% end %>
  <!-- Grid de Clientes -->
  <div class="grid grid-cols-1 gap-4 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
    <% if @clients.any? %>
      <% @clients.each do |client| %>
        <div class="rounded-sm border border-stroke bg-white shadow-default transition-all duration-200 hover:shadow-lg dark:border-strokedark dark:bg-boxdark hover:transform hover:-translate-y-1 <%= 'opacity-75' if client.archived? %> p-4 md:p-6">
          <div class="p-6">
            <!-- Header do Card -->
            <div class="mb-4 flex items-start justify-between">
              <h5 class="text-lg font-semibold text-black dark:text-white">
                <%= link_to client_path(client), class: "font-semibold text-blue-800 hover:text-indigo-600 transition-colors" do %>
                  <%= client.name %>
                  <% if client.archived? %>
                    <span class="ml-1 text-xs text-orange-500">(Arquivado)</span>
                  <% end %>
                <% end %>
              </h5>
              <span class="inline-flex rounded-full px-3 py-1 text-xs font-medium <%= client_status_color(client.status) %>">
                <%= client_status_translation(client.status) %>
                <% if client.expiring? && client.status == 'active' %>
                  <span class="ml-1" title="Expira em <%= client.days_remaining %> dias">⚠️</span>
                <% end %>
              </span>
            </div>
            <!-- Informações do Cliente -->
            <div class="space-y-3 text-sm">
              <div class="flex items-center gap-3">
                <svg class="h-4 w-4 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
                </svg>
                <span class="text-slate-600 dark:text-slate-400">
                  <%= client.phone_number || 'Telefone não informado' %>
                </span>
              </div>
              <div class="flex items-center gap-3">
                <svg class="h-4 w-4 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3a1 1 0 012 0v4m0 0V5a1 1 0 112 0v2m0 0V3a1 1 0 012 0v4M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z"/>
                </svg>
                <span class="text-slate-600 dark:text-slate-400 text-xs">
                  <%= client.start_date&.strftime('%d/%m/%Y') || 'Data não informada' %>
                  a <%= client.end_date&.strftime('%d/%m/%Y') || 'Data não informada' %>
                </span>
              </div>
              <div class="flex items-center gap-3">
                <svg class="h-4 w-4 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/>
                </svg>
                <span class="text-slate-600 dark:text-slate-400">
                  Plano: <%= client.plan_type.present? ? client.plan_type_humanized : 'Não informado' %>
                </span>
              </div>
              <div class="flex items-center gap-3">
                <svg class="h-4 w-4 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
                <span class="font-semibold text-green-600 dark:text-green-400">
                  <% if client.paid_amount.present? %>
                    R$ <%= number_with_precision(client.paid_amount, precision: 2, delimiter: '.', separator: ',') %>
                  <% else %>
                    R$ 0,00
                  <% end %>
                </span>
              </div>
            </div>
            <!-- Botões de Ação -->

            <div class="flex flex-row gap-2 mt-4 justify-center">
              <% unless params[:archived] == 'true' %>
                <!-- Botão Dieta -->
                <%= link_to client_diets_path(client), 
       class: "flex-1 rounded-lg bg-purple-50 text-purple-700 font-medium px-2 py-2 hover:bg-purple-100 transition" do %>
                  <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/>
                  </svg>
                  Dieta
                <% end %>
                <!-- Botão Editar -->
                <%= link_to edit_client_path(client), 
        class: "flex-1 rounded-lg bg-amber-50 text-amber-700 font-medium px-2 py-2 hover:bg-amber-100 transition" do %>
                  <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
                  </svg>
                  Editar
                <% end %>
                <!-- Botão Arquivar -->
                <%= button_to archive_client_path(client), 
        method: :patch,
        data: { 
          turbo_confirm: "Tem certeza que deseja arquivar #{client.name}? Os dados serão preservados mas o cliente ficará oculto."
        },
        class: "flex-1 rounded-lg bg-blue-600 text-white font-medium px-2 py-2 hover:bg-blue-700 transition" do %>
                  <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 8l4 4 4-4m-6 0h12a2 2 0 012 2v8a2 2 0 01-2 2H5a2 2 0 01-2-2v-8a2 2 0 012-2z"/>
                  </svg>
                  Arquivar
                <% end %>
              <% else %>
                <!-- Para clientes arquivados -->
                <%= link_to client_path(client), 
        class: "inline-flex items-center gap-2 px-3 py-2 text-sm font-medium text-white bg-blue-600 rounded-lg hover:bg-blue-700 transition-all duration-200 flex-shrink-0" do %>
                  <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
                  </svg>
                  Ver
                <% end %>
                <%= button_to unarchive_client_path(client), 
        method: :patch,
        data: { turbo_confirm: "Tem certeza que deseja reativar #{client.name}?" },
        class: "inline-flex items-center gap-2 px-3 py-2 text-sm font-medium text-white bg-green-600 rounded-lg hover:bg-green-700 transition-all duration-200 flex-shrink-0" do %>
                  <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/>
                  </svg>
                  Reativar
                <% end %>
              <% end %>
            </div>
          </div>
        </div>
      <% end %>
    <% else %>
      <!-- Estado Vazio -->
      <div class="col-span-full">
        <div class="rounded-sm border border-stroke bg-white p-12 text-center shadow-default dark:border-strokedark dark:bg-boxdark">
          <div class="mx-auto mb-6 h-20 w-20 rounded-full bg-slate-100 dark:bg-slate-800 flex items-center justify-center">
            <% if params[:archived] == 'true' %>
              <svg class="h-10 w-10 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 8l4 4 4-4m-6 0h12a2 2 0 012 2v8a2 2 0 01-2 2H5a2 2 0 01-2-2v-8a2 2 0 012-2z"/>
              </svg>
            <% else %>
              <svg class="h-10 w-10 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/>
              </svg>
            <% end %>
          </div>
          <h3 class="mb-2 text-lg font-semibold text-black dark:text-white">
            <% if params[:archived] == 'true' %>
              Nenhum cliente arquivado
            <% else %>
              Nenhum cliente encontrado
            <% end %>
          </h3>
          <p class="mb-6 text-slate-600 dark:text-slate-400">
            <% if params[:archived] == 'true' %>
              Você não possui clientes arquivados no momento.
            <% elsif params[:search].present? || params[:status].present? || params[:period].present? %>
              Não encontramos clientes com os filtros aplicados. Tente ajustar os critérios de busca.
            <% else %>
              Comece criando seu primeiro cliente para gerenciar dietas e acompanhar o progresso.
            <% end %>
          </p>
          <div class="flex flex-col gap-3 sm:flex-row sm:justify-center">
            <% if params[:search].present? || params[:status].present? || params[:period].present? %>
              <%= link_to clients_path, 
                  class: "inline-flex items-center justify-center rounded-md border border-stroke bg-white px-6 py-3 text-sm font-medium text-black transition hover:bg-slate-50 dark:border-strokedark dark:bg-boxdark dark:text-white dark:hover:bg-slate-800" do %>
                <svg class="mr-2 h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/>
                </svg>
                Limpar Filtros
              <% end %>
            <% elsif params[:archived] != 'true' %>
              <%= link_to new_client_path, 
                  class: "inline-flex items-center justify-center rounded-md bg-green-600 px-6 py-3 text-sm font-medium text-white transition hover:bg-green-700" do %>
                <svg class="mr-2 h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"/>
                </svg>
                Criar Primeiro Cliente
              <% end %>
            <% end %>
          </div>
        </div>
      </div>
    <% end %>
  </div>
  <!-- Paginação -->
  <% if defined?(Kaminari) && @clients.respond_to?(:total_pages) && @clients.total_pages > 1 %>
    <div class="mt-8 flex items-center justify-between">
      <div class="text-sm text-slate-600 dark:text-slate-400">
        Mostrando <%= @clients.offset_value + 1 %> a <%= [@clients.offset_value + @clients.limit_value, @clients.total_count].min %>
        de <%= @clients.total_count %> cliente<%= @clients.total_count == 1 ? '' : 's' %>
      </div>
      <%= paginate @clients, theme: 'twitter_bootstrap_4' %>
    </div>
  <% end %>
</div>
<script>
  function toggleDropdown(clientId) {
    const dropdown = document.getElementById(`dropdown-${clientId}`);
    const button = document.getElementById(`menu-button-${clientId}`);

    // Fechar outros dropdowns abertos
    document.querySelectorAll('[id^="dropdown-"]').forEach(el => {
      if (el.id !== `dropdown-${clientId}`) {
        el.classList.add('hidden');
      }
    });

    // Toggle do dropdown atual
    dropdown.classList.toggle('hidden');
    button.setAttribute('aria-expanded', !dropdown.classList.contains('hidden'));
  }

  // Fechar dropdown ao clicar fora
  document.addEventListener('click', function(event) {
    if (!event.target.closest('[id^="menu-button-"]')) {
      document.querySelectorAll('[id^="dropdown-"]').forEach(el => {
        el.classList.add('hidden');
      });
    }
  });
</script>