<link rel="stylesheet" href="https://unpkg.com/tippy.js@6/themes/light.css" />

<!-- Tippy.js JS -->
<script src="https://unpkg.com/@popperjs/core@2"></script>
<script src="https://unpkg.com/tippy.js@6"></script>
<div class="mb-8 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
  <div>
    <h2 class="text-2xl font-bold text-gray-900 dark:text-white">
      Dieta de <%= @client.name %>
    </h2>
    <nav>
      <ol class="flex items-center gap-2 text-sm text-gray-500">
        <%= link_to clients_path, class: "hover:text-blue-600" do %>
          Pacientes
        <% end %>
        <span>/</span>
        <%= link_to @client, class: "hover:text-blue-600" do %>
          <%= @client.name %>
        <% end %>
        <span>/</span>
        <span class="text-gray-700 dark:text-white font-semibold">Dietas</span>
      </ol>
    </nav>
  </div>
  <div class="flex flex-col gap-2 w-full sm:flex-row sm:gap-3 sm:w-auto items-stretch">
    <div class="relative" x-data="{ dropdownOpen: false }" @click.outside="dropdownOpen = false">
      <%= link_to diet_pdf_client_path(@client, format: :pdf), 
      class: "inline-flex items-center gap-2.5 rounded bg-blue-600 px-4 py-2 text-white font-medium hover:bg-blue-700 transition",
      target: "_blank" do %>
        <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
        </svg>
        PDF
      <% end %>
      
    </div>
    <%= link_to new_client_diet_path(@client), 
      class: "inline-flex items-center gap-2.5 rounded bg-green-600 px-4 py-2 text-white font-medium hover:bg-green-700 transition" do %>
      <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
      </svg>
      Nova Refeição
    <% end %>
    <%= link_to @client, 
      class: "inline-flex items-center gap-2.5 rounded bg-gray-200 px-4 py-2 text-gray-700 font-medium hover:bg-gray-300 transition" do %>
      <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
      </svg>
      Voltar
    <% end %>
  </div>
</div>
<!-- Grid Layout: refeições à esquerda, observação à direita -->
<div class="flex flex-col gap-6 md:flex-row md:items-start">
  <div class="flex flex-col gap-6 w-full md:flex-wrap md:flex-row md:gap-4 flex-1 min-w-0">
    <% if @diets.any? %>
      <div id="diets-list"
        data-client-id="<%= @client.id %>"
        data-reorder-url="<%= client_reorder_diets_path(@client) %>"
        class="flex flex-col gap-6 sm:grid sm:grid-cols-1 md:grid-cols-2 xl:grid-cols-3">
        <% @diets.each_with_index do |diet, idx| %>
          <div id="diet-card-<%= diet.id %>"
            draggable="true"
            class="diet-card rounded-lg border border-gray-200 bg-white p-6 shadow-sm flex flex-col gap-4 relative w-full"
            data-id="<%= diet.id %>">
            <div class="flex items-center justify-between">
              <span class="drag-handle cursor-grab mr-2 flex items-center justify-center text-gray-400 hover:text-blue-500 transition duration-150" aria-label="Arraste para reordenar">
                <svg width="20" height="20" fill="currentColor" viewBox="0 0 20 20">
                  <circle cx="5" cy="6" r="1.5"/>
                  <circle cx="5" cy="10" r="1.5"/>
                  <circle cx="5" cy="14" r="1.5"/>
                  <circle cx="15" cy="6" r="1.5"/>
                  <circle cx="15" cy="10" r="1.5"/>
                  <circle cx="15" cy="14" r="1.5"/>
                </svg>
              </span>
              <div class="diet-name-group">
                <span class="diet-name" data-id="<%= diet.id %>"><%= diet.name %></span>
                <input class="diet-name-input hidden" type="text" value="<%= diet.name %>" data-id="<%= diet.id %>" maxlength="60" />
              </div>
              <span class="rounded bg-blue-50 px-3 py-1 text-xs font-bold text-blue-600"><%= diet.total_calories.round(1) %> kcal</span>
            </div>
            <% if diet.notes.present? %>
              <div class="flex items-center gap-2 text-sm text-gray-500">
                <span><%= diet.notes.truncate(80) %></span>
              </div>
            <% end %>
            <% if diet.diet_foods.any? %>
              <ul class="flex flex-col gap-1 text-sm text-gray-700">
                <% diet.diet_foods.limit(5).each do |df| %>
                  <li>
                    <span class="font-bold text-gray-900"><%= df.quantity_grams.to_i %>g</span>
                    <%= df.food.name.split(',').first %>
                  </li>
                <% end %>
                <% if diet.diet_foods.count > 5 %>
                  <li class="text-xs text-gray-400">+ <%= diet.diet_foods.count - 5 %> mais alimento<%= 's' if diet.diet_foods.count - 5 > 1 %></li>
                <% end %>
              </ul>
            <% else %>
              <p class="text-sm italic text-gray-400">Nenhum alimento adicionado</p>
            <% end %>
            <!-- Macros -->
            <div class="grid grid-cols-3 gap-2">
              <div class="rounded bg-blue-50 p-2 text-center text-blue-700">
                <span class="font-bold"><%= diet.total_protein.round(1) %>g</span>
                <span class="block text-xs">Proteína</span>
              </div>
              <div class="rounded bg-green-50 p-2 text-center text-green-700">
                <span class="font-bold"><%= diet.total_carbs.round(1) %>g</span>
                <span class="block text-xs">Carb</span>
              </div>
              <div class="rounded bg-red-50 p-2 text-center text-red-700">
                <span class="font-bold"><%= diet.total_fat.round(1) %>g</span>
                <span class="block text-xs">Gordura</span>
              </div>
            </div>
            <!-- Footer -->
            <div class="flex gap-2 pt-3 flex-col sm:flex-row">
              <%= link_to client_diet_path(@client, diet), class: "flex-1 rounded border border-blue-600 bg-white px-2 py-1 text-blue-600 text-sm hover:bg-blue-50" do %>
                Editar
              <% end %>
              <%= button_to duplicate_client_diet_path(@client, diet), method: :post, class: "flex-1 rounded border border-indigo-600 bg-white px-2 py-1 text-indigo-600 text-sm hover:bg-indigo-50" do %>
                Duplicar
              <% end %>
              <%= button_to client_diet_path(@client, diet), method: :delete, data: { turbo_confirm: "Excluir #{diet.name}?" }, class: "flex-1 rounded border border-red-600 bg-white px-2 py-1 text-red-600 text-sm hover:bg-red-50" do %>
                Excluir
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
      <!-- Resumo total de macros -->
      <!-- Resumo total de macros: ajuste responsivo -->
  
    <% else %>
  <!-- ✅ ESTADO VAZIO MELHORADO - Centralizado -->
  <div class="flex min-h-[50vh] items-center justify-center py-12">
    <div class="mx-auto max-w-lg text-center">
      <!-- Ícone de refeição/nutrição -->
      <div class="mx-auto mb-8 flex h-24 w-24 items-center justify-center rounded-full bg-green-100 dark:bg-green-900/20">
        <svg class="h-12 w-12 text-green-600 dark:text-green-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/>
        </svg>
      </div>

      <!-- Título principal -->
      <h3 class="mb-4 text-2xl font-bold text-gray-900 dark:text-white">
        Comece criando a primeira refeição para <%= @client.name %>!
      </h3>

      <!-- Descrição -->
      <p class="mb-8 text-base text-gray-600 dark:text-gray-400 leading-relaxed">
        Monte um plano alimentar completo com café da manhã, almoço, jantar e lanches. 
      </p>

      <!-- Botão de ação principal -->
      <%= link_to new_client_diet_path(@client), 
          class: "inline-flex items-center gap-3 rounded-lg bg-green-600 px-8 py-4 text-lg font-semibold text-white shadow-lg transition-all duration-200 hover:bg-green-700 hover:shadow-xl hover:-translate-y-1 transform" do %>
        <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"/>
        </svg>
        Nova Refeição
      <% end %>

      <!-- Links secundários -->
      <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:justify-center sm:gap-6">
        <%= link_to @client, 
            class: "inline-flex items-center gap-2 text-sm text-gray-600 hover:text-gray-800 dark:text-gray-400 dark:hover:text-gray-200 transition-colors font-medium" do %>
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
          </svg>
          Perfil de <%= @client.name %>
        <% end %>

        <%= link_to clients_path, 
            class: "inline-flex items-center gap-2 text-sm text-gray-600 hover:text-gray-800 dark:text-gray-400 dark:hover:text-gray-200 transition-colors font-medium" do %>
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/>
          </svg>
          Todos os clientes
        <% end %>
      </div>


    </div>
  </div>
<% end %>
<script>
  document.addEventListener('DOMContentLoaded', function() {
  const list = document.getElementById('diets-list');
  const clientId = list ? list.dataset.clientId : null;
  let draggedCard = null;

  // --- Drag & Drop ---
  if (list) {
    list.querySelectorAll('.diet-card').forEach(card => {
      card.addEventListener('dragstart', function(e) {
        draggedCard = card;
        card.classList.add('dragging');
        e.dataTransfer.effectAllowed = "move";
        var img = document.createElement("img");
        img.src = "data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAQAAAC1HAwCAAAAC0lEQVR42mNk+A8AAksB9Xc4Fz4AAAAASUVORK5CYII=";
        e.dataTransfer.setDragImage(img, 0, 0);
      });

      card.addEventListener('dragend', function() {
        card.classList.remove('dragging');
        draggedCard = null;
      });

      card.addEventListener('dragover', function(e) {
        e.preventDefault();
        if (draggedCard && draggedCard !== card) {
          card.classList.add('over');
        }
      });

      card.addEventListener('dragleave', function(e) {
        card.classList.remove('over');
      });

      card.addEventListener('drop', function(e) {
        e.preventDefault();
        card.classList.remove('over');
        if (draggedCard && draggedCard !== card) {
          swapCards(draggedCard, card);
          showSaving();
          sendOrderToServer();
        }
      });
    });

    function swapCards(cardA, cardB) {
      const parent = cardA.parentNode;
      const siblingA = cardA.nextSibling === cardB ? cardA : cardA.nextSibling;
      parent.insertBefore(cardA, cardB);
      parent.insertBefore(cardB, siblingA);
    }

    function sendOrderToServer() {
      const order = Array.from(list.querySelectorAll('.diet-card')).map((el, idx) => ({
        id: el.dataset.id,
        position: idx + 1
      }));

      fetch(list.dataset.reorderUrl, {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
          "X-CSRF-Token": document.querySelector("[name='csrf-token']").content
        },
        body: JSON.stringify({order})
      })
      .then(resp => {
        if (!resp.ok) throw new Error("Erro ao salvar ordem (status " + resp.status + ")");
        return resp.json();
      })
      .then(data => {
        showSaved(data.success);
      })
      .catch(err => {
        showSaved(false);
        showNotice("Erro ao salvar ordem (" + err.message + ")");
      });
    }
  }

  // --- Inline Edit ---
  function closeAllInputs() {
    document.querySelectorAll('.diet-name-input:not(.hidden)').forEach(function(input) {
      input.classList.add('hidden');
      input.classList.remove('saving', 'saved', 'error');
      let span = input.parentElement.querySelector('.diet-name');
      if (span) span.style.display = '';
    });
  }

  document.querySelectorAll('.diet-name').forEach(function(nameSpan) {
    nameSpan.addEventListener('click', function(e) {
      closeAllInputs();
      const input = nameSpan.parentElement.querySelector('.diet-name-input');
      nameSpan.style.display = 'none';
      input.value = nameSpan.textContent.trim();
      input.classList.remove('hidden');
      input.focus();
      input.select();
      e.stopPropagation();
    });
  });

  document.querySelectorAll('.diet-name-input').forEach(function(input) {
    input.addEventListener('blur', saveName);
    input.addEventListener('keydown', function(e) {
      if (e.key === 'Enter') {
        saveName.call(input, e);
      } else if (e.key === 'Escape') {
        cancelEdit(input);
      }
    });
  });

  function saveName(e) {
    const input = this;
    const id = input.dataset.id;
    const nameSpan = input.parentElement.querySelector('.diet-name');
    const newName = input.value.trim();
    if (!clientId) {
      cancelEdit(input);
      return;
    }
    if (newName.length === 0 || newName === nameSpan.textContent.trim()) {
      cancelEdit(input);
      return;
    }
    input.classList.add('saving');
    input.classList.remove('error', 'saved');

    fetch(`/clients/${clientId}/diets/${id}`, {
      method: 'PATCH',
      headers: {
        'Content-Type': 'application/json',
        'Accept': 'application/json',
        'X-CSRF-Token': document.querySelector('[name="csrf-token"]').content
      },
      body: JSON.stringify({ diet: { name: newName } })
    })
    .then(resp => resp.ok ? resp.json() : Promise.reject(resp))
    .then(data => {
      input.classList.remove('saving', 'error');
      input.classList.add('saved');
      nameSpan.textContent = data.name || newName;
      setTimeout(() => input.classList.remove('saved'), 800);
      nameSpan.style.display = '';
      input.classList.add('hidden');
      if (data.notice) showNotice(data.notice);
    })
    .catch(() => {
      input.classList.remove('saving', 'saved');
      input.classList.add('error');
      setTimeout(() => {
        input.classList.remove('error');
        cancelEdit(input);
      }, 1500);
    });
  }

  function cancelEdit(input) {
    input.classList.add('hidden');
    input.classList.remove('saving', 'saved', 'error');
    input.parentElement.querySelector('.diet-name').style.display = '';
  }

  // --- Notice helpers ---
  function showNotice(message) {
    let notice = document.getElementById('diet-notice');
    if (!notice) {
      notice = document.createElement('div');
      notice.id = 'diet-notice';
      notice.style.position = 'fixed';
      notice.style.top = '20px';
      notice.style.right = '20px';
      notice.style.background = '#38a169';
      notice.style.color = 'white';
      notice.style.padding = '10px 20px';
      notice.style.borderRadius = '8px';
      notice.style.zIndex = '9999';
      notice.style.fontWeight = 'bold';
      document.body.appendChild(notice);
    }
    notice.textContent = message;
    notice.style.display = 'block';
    setTimeout(() => { notice.style.display = 'none'; }, 2000);
  }

  function showSaving() {
    let notice = document.getElementById('save-notice');
    if (!notice) {
      notice = document.createElement('div');
      notice.id = 'save-notice';
      notice.style.position = 'fixed';
      notice.style.top = '20px';
      notice.style.right = '20px';
      notice.style.background = '#4299e1';
      notice.style.color = 'white';
      notice.style.padding = '10px 20px';
      notice.style.borderRadius = '8px';
      notice.style.zIndex = '9999';
      notice.style.fontWeight = 'bold';
      document.body.appendChild(notice);
    }
    notice.textContent = "Salvando ordem...";
    notice.style.display = 'block';
  }

  function showSaved(success) {
    let notice = document.getElementById('save-notice');
    if (notice) {
      notice.textContent = success ? "Ordem salva!" : "Erro ao salvar ordem";
      setTimeout(() => { notice.style.display = 'none'; }, 1500);
    }
  }
  });
</script>
<script>
function showTipToast(message, duration = 4000) {
  let toast = document.getElementById('tip-toast');
  if (!toast) {
    toast = document.createElement('div');
    toast.id = 'tip-toast';
    toast.style.position = 'fixed';
    toast.style.top = '20px';
    toast.style.right = '20px';
    toast.style.background = '#4299e1';
    toast.style.color = 'white';
    toast.style.padding = '14px 24px';
    toast.style.borderRadius = '8px';
    toast.style.zIndex = '9999';
    toast.style.fontWeight = 'bold';
    toast.style.boxShadow = '0 2px 8px rgba(0,0,0,0.15)';
    toast.style.display = 'flex';
    toast.style.alignItems = 'center';
    toast.innerHTML = `<span>${message}</span><button id="tip-toast-ok" style="margin-left:16px;background:#2563eb;color:white;border:none;border-radius:5px;padding:4px 12px;cursor:pointer">OK</button>`;
    document.body.appendChild(toast);

    document.getElementById('tip-toast-ok').onclick = function() {
      toast.remove();
      localStorage.setItem('tipToastDismissed', '1');
    };
  } else {
    toast.style.display = 'flex';
    toast.querySelector('span').textContent = message;
  }
  if (!localStorage.getItem('tipToastDismissed')) {
    setTimeout(() => {
      if (toast) toast.style.display = 'none';
    }, duration);
  }
}

// Exemplo de uso: Só mostra se não foi dispensado antes
if (!localStorage.getItem('tipToastDismissed')) {
  showTipToast('💡 Dica: Arraste os cards para reordenar e clique no nome para editar!', 5000);
}
  </script>

