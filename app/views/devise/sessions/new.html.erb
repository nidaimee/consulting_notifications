<style>
.login-container {
  min-height: 100vh;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20px;
}

.login-card {
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(10px);
  border-radius: 20px;
  box-shadow: 0 15px 35px rgba(0, 0, 0, 0.1);
  padding: 40px;
  width: 100%;
  max-width: 420px;
  border: 1px solid rgba(255, 255, 255, 0.2);
}

.login-header {
  text-align: center;
  margin-bottom: 30px;
}

.login-icon {
  width: 80px;
  height: 80px;
  background: linear-gradient(135deg, #6366f1, #8b5cf6);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 20px;
  box-shadow: 0 10px 25px rgba(99, 102, 241, 0.3);
}

.login-title {
  color: #1e293b;
  font-size: 28px;
  font-weight: 700;
  margin-bottom: 8px;
}

.login-subtitle {
  color: #64748b;
  font-size: 16px;
  margin-bottom: 0;
}

.form-floating {
  margin-bottom: 20px;
}

.form-floating input {
  border: 2px solid #e2e8f0;
  border-radius: 12px;
  padding: 20px 16px 8px;
  font-size: 16px;
  transition: all 0.3s ease;
}

.form-floating input:focus {
  border-color: #6366f1;
  box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.1);
}

.form-floating label {
  color: #64748b;
  font-weight: 500;
}

.btn-login {
  background: linear-gradient(135deg, #6366f1, #8b5cf6);
  border: none;
  border-radius: 12px;
  padding: 16px;
  font-size: 16px;
  font-weight: 600;
  width: 100%;
  color: white;
  transition: all 0.3s ease;
  box-shadow: 0 4px 15px rgba(99, 102, 241, 0.3);
}

.btn-login:hover {
  transform: translateY(-2px);
  box-shadow: 0 8px 25px rgba(99, 102, 241, 0.4);
  background: linear-gradient(135deg, #5b5fd9, #7c3aed);
}

.alert-custom {
  background: rgba(239, 68, 68, 0.1);
  border: 1px solid rgba(239, 68, 68, 0.2);
  color: #dc2626;
  border-radius: 12px;
  padding: 12px 16px;
  margin-bottom: 20px;
  font-size: 14px;
}

.create-account-link {
  text-align: center;
  margin-top: 20px;
  padding-top: 20px;
  border-top: 1px solid #e2e8f0;
}

.create-account-link a {
  color: #6366f1;
  text-decoration: none;
  font-weight: 500;
  transition: color 0.3s ease;
}

.create-account-link a:hover {
  color: #5b5fd9;
}

@media (max-width: 480px) {
  .login-card {
    padding: 30px 20px;
    margin: 20px;
  }
  
  .login-icon {
    width: 60px;
    height: 60px;
  }
  
  .login-title {
    font-size: 24px;
  }
}
</style>

<div class="login-container">
  <div class="login-card">
    <div class="login-header">
      <h2 class="login-title">Bem-vindo!</h2>
      <p class="login-subtitle">Faça login para acessar sua conta</p>
    </div>

    <% if flash[:alert] %>
      <div class="alert-custom">
        <i class="fas fa-exclamation-triangle me-2"></i>
        <%= flash[:alert] %>
      </div>
    <% end %>

    <%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
      <div class="form-floating">
        <%= f.email_field :email, 
            autofocus: true, 
            class: "form-control", 
            id: "email",
            placeholder: "seu@email.com",
            required: true %>
        <%= f.label :email, "E-mail", for: "email" %>
      </div>

      <div class="form-floating">
        <%= f.password_field :password, 
            class: "form-control", 
            id: "password",
            placeholder: "Digite sua senha",
            required: true %>
        <%= f.label :password, "Senha", for: "password" %>
      </div>

      <%= f.submit "Entrar", class: "btn btn-login" %>
    <% end %>

  </div>
</div>